---
import "../styles/site.css";
import { content, locales, type Locale } from "../data";

type Props = { lang: Locale };

const { lang } = Astro.props;
const page = content[lang];

function localeHref(target: Locale) {
  if (lang === "nl") {
    return target === "nl" ? "./" : `./${target}/`;
  }

  return target === "nl" ? "../" : target === lang ? "./" : `../${target}/`;
}

const langLinks = locales.map((code) => ({
  code,
  href: localeHref(code),
}));

// YouTube video ID — client-selected Marbella background video
const HERO_VIDEO_ID = "3QUKrxHDFjo";

// Spot images — swap these three URLs with final client photography
// Recommended: Marbella Old Town, Puerto Banus marina, luxury villa with sea view
const spotImages = [
  "/nueva_andalucia.jpg", // Marbella West
  "/plaza-de-los-naranjos.png", // Marbella Center
  "/istockphoto-1346794935-612x612.jpg", // Marbella East
];

const responsiveServiceImages = {
  "/service-rental-keys.webp": "service-rental-keys",
  "/service-extra-security-camera.webp": "service-extra-security-camera",
} as const;

type ResponsiveServiceImage = keyof typeof responsiveServiceImages;

function getServiceCardImageSources(image: string) {
  const key = image as ResponsiveServiceImage;
  const baseName = responsiveServiceImages[key];

  if (!baseName) return null;

  const widths = [420, 640, 900];

  return {
    avifSrcSet: widths.map((width) => `/${baseName}-${width}.avif ${width}w`).join(", "),
    webpSrcSet: widths.map((width) => `/${baseName}-${width}.webp ${width}w`).join(", "),
    jpgSrcSet: widths.map((width) => `/${baseName}-${width}.jpg ${width}w`).join(", "),
    fallbackSrc: `/${baseName}-640.jpg`,
    sizes: "(max-width: 720px) 100vw, (max-width: 1080px) 100vw, 26vw",
  };
}
---

<!doctype html>
<html lang={lang} translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/png" href="/maximum-managed-logo-symbol.png" />
    <link rel="apple-touch-icon" href="/maximum-managed-logo-symbol.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{page.metaTitle}</title>
  </head>

  <body id="top">

    <!-- ── HEADER ──────────────────────────────────────────────────────── -->
    <header class="site-header">
      <div class="header-inner">
        <a class="brand notranslate" href={localeHref(lang)}>
          <img
            class="brand-logo"
            src="/maximum-managed-header.svg"
            alt="Maximum Managed"
            width="2917"
            height="1336"
          />
        </a>

        <nav class="nav">
          <a href="#about">{page.nav.about}</a>
          <a href="#services">{page.nav.services}</a>
          <a href="#approach">{page.nav.approach}</a>
          <a href="#area">{page.nav.area}</a>
          <a href="#contact">{page.nav.contact}</a>
        </nav>

        <div class="langs notranslate">
          {langLinks.map((item) => (
            <a
              class="notranslate"
              href={item.href}
              aria-current={item.code === lang ? "page" : undefined}
              translate="no"
            >
              {item.code.toUpperCase()}
            </a>
          ))}
        </div>

        <details class="mobile-menu notranslate">
          <summary aria-label="Open menu" translate="no">
            <span class="mobile-menu-icon" aria-hidden="true"></span>
          </summary>
          <div class="mobile-menu-panel">
            <div class="mobile-menu-header">
              <img
                class="mobile-menu-logo"
                src="/maximum-managed-header.svg"
                alt="Maximum Managed"
                width="200"
                height="92"
              />
              <button class="mobile-menu-close" aria-label="Close menu">&times;</button>
            </div>
            <nav class="mobile-menu-nav" aria-label="Mobile navigation">
              <a href="#about">
                <span class="nav-num">01</span>
                <span class="nav-label">{page.nav.about}</span>
              </a>
              <a href="#services">
                <span class="nav-num">02</span>
                <span class="nav-label">{page.nav.services}</span>
              </a>
              <a href="#approach">
                <span class="nav-num">03</span>
                <span class="nav-label">{page.nav.approach}</span>
              </a>
              <a href="#area">
                <span class="nav-num">04</span>
                <span class="nav-label">{page.nav.area}</span>
              </a>
              <a href="#contact">
                <span class="nav-num">05</span>
                <span class="nav-label">{page.nav.contact}</span>
              </a>
            </nav>

            <div class="mobile-menu-footer">
              <div class="mobile-menu-langs" aria-label="Select language">
                {langLinks.map((item) => (
                  <a
                    class="notranslate"
                    href={item.href}
                    aria-current={item.code === lang ? "page" : undefined}
                    translate="no"
                  >
                    {item.code.toUpperCase()}
                  </a>
                ))}
              </div>
              <div class="mobile-menu-contact">
                <a href="mailto:contact@maximum-managed.com" class="contact-link">contact@maximum-managed.com</a>
              </div>
            </div>
          </div>
        </details>
      </div>
    </header>

    <main>

      <!-- ── HERO with YouTube video background ──────────────────────── -->
      <section class="hero">

        <!-- YouTube iframe cover -->
        <div class="hero-video-wrap" aria-hidden="true">
          <iframe
            src={`https://www.youtube.com/embed/${HERO_VIDEO_ID}?autoplay=1&mute=1&loop=1&playlist=${HERO_VIDEO_ID}&controls=0&disablekb=1&modestbranding=1&playsinline=1&rel=0&vq=hd1080&iv_load_policy=3&cc_load_policy=0&fs=0`}
            title="Maximum Managed — Marbella"
            allow="autoplay; encrypted-media"
            allowfullscreen={false}
          ></iframe>
        </div>

        <!-- Content -->
        <div class="hero-content">
          <div class="shell">
            <div class="hero-grid">

              <div class="hero-main">
                <p class="eyebrow">{page.hero.eyebrow}</p>
                <h1>{page.hero.title}</h1>
                <div class="hero-actions">
                  <a class="button primary" href="#contact">{page.hero.primary}</a>
                  <a class="button secondary" href="#services">{page.hero.secondary}</a>
                </div>
              </div>

              <!-- Desktop only — participates in parallax alongside hero text -->
              <aside class="hero-note hero-note-desktop">
                <h2>{page.hero.noteTitle}</h2>
                <p>{page.hero.noteText}</p>
              </aside>

            </div>
          </div>
        </div>
      </section>

      <!-- Mobile-only note card: lives outside the hero so it's never
           covered by the video and doesn't participate in the parallax -->
      <div class="hero-note-mobile-wrap">
        <div class="shell">
          <aside class="hero-note">
            <h2>{page.hero.noteTitle}</h2>
            <p>{page.hero.noteText}</p>
          </aside>
        </div>
      </div>

      <!-- ── INTRO (light) ────────────────────────────────────────────── -->
      <section class="section-intro-light">
        <div class="shell">
          <div class="intro-editorial">

            <!-- Left: big editorial statement -->
            <div class="intro-statement">
              <p class="intro-kicker">Property management</p>
              <h2 class="intro-headline">{page.intro.headline}</h2>
            </div>

            <!-- Right: three original paragraphs + trust bar -->
            <div class="intro-support">
              <p class="intro-p">
                {page.intro.paragraphs[0]}
              </p>
              <p class="intro-p">
                <em class="intro-accent">{page.intro.accent}</em>{page.intro.paragraphs[1]}
              </p>
              <p class="intro-p">
                {page.intro.paragraphs[2]}
              </p>

              <div class="intro-trust-bar">
                <div class="intro-trust-item">
                  <span class="intro-trust-num">100%</span>
                  <span class="intro-trust-label">{page.intro.trust[0]}</span>
                </div>
                <div class="intro-trust-divider"></div>
                <div class="intro-trust-item">
                  <span class="intro-trust-num">NL</span>
                  <span class="intro-trust-label">{page.intro.trust[1]}</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ── ABOUT (light, with photo) ───────────────────────────────── -->
      <section class="section-about" id="about">
        <div class="shell">
          <div class="about-grid">

            <div class="about-copy">
              <p class="eyebrow-dark">{page.about.kicker}</p>
              <h2>{page.about.title}</h2>
              <div class="copy">
                {page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="chips">
                {page.about.chips.map((chip) => <span>{chip}</span>)}
              </div>
            </div>

            <!-- Photo — swap src for real team photo when available -->
            <div class="about-photo">
              <img 
                class="about-photo-image"
                src="/team-photo-edited.png"
                alt="Maximum Managed team"
              />
            </div>

          </div>
        </div>
      </section>

      <!-- ── SERVICES (stacking cards on scroll) ─────────────────────── -->
      <section class="section-services" id="services">
        <div class="shell">
          <div class="services-header">
            <p class="eyebrow">{page.services.kicker}</p>
            <h2 class="section-title">{page.services.title}</h2>
            <div class="gold-rule"></div>
            <p class="section-lead">{page.services.intro}</p>
          </div>
        </div>
      <div class="shell">
        <div class="services-grid">
          {page.services.cards.map((item, index) => (
            <article
              class={`service-card reveal-card ${index % 2 === 0 ? "reveal-left" : "reveal-right"}`}
              style={`--reveal-delay: ${index * 90}ms;`}
            >
              <div class="service-card-content">
                <div class="service-card-head">
                  <h3 class="service-card-title">{item.title}</h3>
                </div>
                {item.subtitle && <p class="service-card-subtitle">{item.subtitle}</p>}
                <ul class="service-card-list">
                  {item.bullets?.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </div>
              {item.image && (
                <div class="service-card-image-wrap">
                  {(() => {
                    const responsiveSources = getServiceCardImageSources(item.image);
                    const imageClass = `service-card-image ${item.image.includes("service-extra-security-camera") ? "service-card-image-camera" : ""} ${item.image === "/service-property-management.jpg" ? "service-card-image-towels" : ""}`;
                    const imageStyle = item.image.includes("service-extra-security-camera")
                      ? "object-position: 75% center;"
                      : item.image === "/service-property-management.jpg"
                        ? "object-position: 15% center;"
                        : "";

                    if (responsiveSources) {
                      return (
                        <picture>
                          <source
                            type="image/avif"
                            srcset={responsiveSources.avifSrcSet}
                            sizes={responsiveSources.sizes}
                          />
                          <source
                            type="image/webp"
                            srcset={responsiveSources.webpSrcSet}
                            sizes={responsiveSources.sizes}
                          />
                          <img
                            src={responsiveSources.fallbackSrc}
                            srcset={responsiveSources.jpgSrcSet}
                            sizes={responsiveSources.sizes}
                            alt={item.title}
                            class={imageClass}
                            loading="lazy"
                            decoding="async"
                            style={imageStyle}
                          />
                        </picture>
                      );
                    }

                    return (
                      <img
                        src={item.image}
                        alt={item.title}
                        class={imageClass}
                        loading="lazy"
                        decoding="async"
                        style={imageStyle}
                      />
                    );
                  })()}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

      <!-- ── APPROACH (light) ─────────────────────────────────────────── -->
      <section class="section-approach" id="approach">
        <div class="shell">
          <div class="approach-grid">

            <div class="approach-header">
              <p class="eyebrow-dark">{page.approach.kicker}</p>
              <h2>{page.approach.title}</h2>
              <div class="gold-rule" style="margin: 16px 0;"></div>
              <p>{page.approach.intro}</p>
            </div>

            <div class="approach-points">
              {page.approach.points.map((point, i) => (
                <div class="approach-point">
                  <span class="approach-point-num">{String(i + 1).padStart(2, "0")}</span>
                  <p>{point}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      </section>

      <!-- ── REASONS (dark, clean list) ──────────────────────────────── -->
      <section class="section-reasons">
        <div class="shell">
          <div class="reasons-grid">

            <div>
              <p class="eyebrow">{page.reasons.kicker}</p>
              <h2 class="section-title">{page.reasons.title}</h2>
              <div class="gold-rule" style="margin-top: 16px;"></div>
            </div>

            <div class="reasons-list">
              {page.reasons.items.map((item) => (
                <div class="reason-item">
                  <span class="reason-dot"></span>
                  <p>{item}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      </section>

      <!-- ── AREA (light, with photo cards) ──────────────────────────── -->
      <section class="section-area" id="area">
        <div class="shell">
          <div class="area-header">
            <p class="eyebrow-dark">{page.area.kicker}</p>
            <h2 class="section-title dark">{page.area.title}</h2>
            <div class="gold-rule" style="margin: 16px 0;"></div>
            <p class="section-lead dark">{page.area.text}</p>
          </div>

          <div class="spot-grid">
            {page.area.spots.map((spot, i) => (
              <article class="spot-card">
                <img
                  class="spot-card-image"
                  src={spotImages[i]}
                  alt={spot.title}
                  loading="lazy"
                  decoding="async"
                />
                <div class="spot-card-body">
                  <h3>{spot.title}</h3>
                  {spot.text && <p>{spot.text}</p>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ── CONTACT (dark) ───────────────────────────────────────────── -->
      <section class="section-contact" id="contact">
        <div class="shell">
          <div class="contact-grid">

            <!-- Left: copy -->
            <div class="contact-header">
              <p class="eyebrow">{page.contact.kicker}</p>
              <h2>{page.contact.title}</h2>
              <div class="gold-rule" style="margin: 16px 0 20px;"></div>
              <p>{page.contact.text}</p>
              <div class="contact-actions">
                <a class="button primary" href="mailto:contact@maximum-managed.com">{page.contact.primary}</a>
              </div>

              <!-- Email — bajo el copy en lugar de columna separada -->
              <div class="contact-reach">
                <p class="contact-reach-label">E-mail</p>
                <a class="contact-email notranslate" href="mailto:contact@maximum-managed.com">
                  contact@maximum-managed.com
                </a>
                <div class="contact-phones notranslate">
                  <p class="contact-reach-label">{page.contact.phoneLabel}</p>
                  {page.contact.people.map((person) => (
                    <>
                      <p class="contact-person">{person.name}</p>
                      {person.phones.map((phone) => (
                        <a class="contact-phone" href={`tel:${phone.href}`}>{phone.label}</a>
                      ))}
                    </>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right: team photo — swap src when final photo is ready -->
            <div class="contact-photo-wrap">
              <img
                class="contact-photo"
                src="/team-photo-edited.png"
                alt="Maximum Managed team"
                loading="lazy"
                decoding="async"
              />
              <!-- Replace src above with final team photo — all sizing is handled by CSS -->
            </div>

          </div>
        </div>
      </section>

    </main>

    <!-- ── FOOTER ──────────────────────────────────────────────────────── -->
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-inner">
          <div class="footer-brand">
            <img
              class="footer-logo"
              src="/maximum-managed-logo-full.png"
              alt="Maximum Managed"
              width="420"
              height="252"
            />
            <p>{page.footer.tagline}</p>
          </div>
          <p class="footer-note">{page.footer.note}</p>
        </div>
      </div>
    </footer>
    
    <!-- ── WHATSAPP WIDGET ─────────────────────────────────────────────── -->
    <a 
      href="https://wa.me/34666697743"
      class="whatsapp-widget" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
    >
      <div class="whatsapp-message" set:html={page.contact.whatsapp.replace("**", "<strong>").replace("**", "</strong>")}></div>
      <div class="whatsapp-icon-wrap">
        <img src="/whatsapp-icon.jpg" alt="WhatsApp" class="whatsapp-icon-img" />
      </div>
    </a>

  <script>
    // Mide el header real y actualiza --header-h para que las sticky cards
    // nunca queden tapadas, independientemente del breakpoint o del wrapping de texto.
    const header = document.querySelector<HTMLElement>(".site-header");

    const syncHeaderHeight = () => {
      if (!header) return;
      const h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty("--header-h", `${Math.ceil(h)}px`);
    };

    syncHeaderHeight();
    window.addEventListener("resize", syncHeaderHeight, { passive: true });

    const mobileMenu = document.querySelector<HTMLDetailsElement>(".mobile-menu");

    if (mobileMenu) {
      const closeBtn = mobileMenu.querySelector(".mobile-menu-close");
      
      if (closeBtn) {
        closeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          mobileMenu.open = false;
          document.body.style.overflow = "";
        });
      }

      mobileMenu.addEventListener("toggle", () => {
        if (mobileMenu.open) {
          document.body.style.overflow = "hidden";
        } else {
          document.body.style.overflow = "";
        }
      });

      mobileMenu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.open = false;
          document.body.style.overflow = "";
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node) || mobileMenu.contains(target)) return;
        if (mobileMenu.open) {
          mobileMenu.open = false;
          document.body.style.overflow = "";
        }
      });
    }

    // Hero parallax: text moves up at ~40% of scroll speed, video stays fixed.
    // rAF + passive listener keeps it smooth and off the main thread.
    const heroContent = document.querySelector<HTMLElement>(".hero-content");
    const hero = document.querySelector<HTMLElement>(".hero");

    if (heroContent && hero) {
      let ticking = false;

      const update = () => {
        const scrollY = window.scrollY;
        const heroH = hero.offsetHeight;

        // Only apply while hero is still visible
        if (scrollY <= heroH) {
          // 0.4 = parallax speed factor (text moves at 40% of scroll speed)
          heroContent.style.transform = `translateY(${scrollY * 0.4}px)`;
        }
        ticking = false;
      };

      window.addEventListener("scroll", () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
        }, { passive: true });
    }

    document.documentElement.classList.add("js");

    const revealCards = Array.from(document.querySelectorAll<HTMLElement>(".reveal-card"));

    if (revealCards.length) {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion) {
        revealCards.forEach((card) => card.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
        );

        revealCards.forEach((card) => observer.observe(card));
      }
    }

    const whatsappWidget = document.querySelector<HTMLAnchorElement>(".whatsapp-widget");

    if (whatsappWidget) {
      const whatsappPhone = "34666697743";
      const whatsappAppUrl = `whatsapp://send?phone=${whatsappPhone}`;
      const whatsappFallbackUrl = `https://wa.me/${whatsappPhone}`;
      const isMobileDevice = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

      // Mobile browsers should attempt deep-linking directly into WhatsApp first.
      if (isMobileDevice) {
        whatsappWidget.href = whatsappAppUrl;
        whatsappWidget.target = "_self";
        whatsappWidget.rel = "";

        whatsappWidget.addEventListener("click", () => {
          window.setTimeout(() => {
            // If the app did not open, keep the journey on a WhatsApp-compatible URL.
            if (document.visibilityState === "visible") {
              window.location.href = whatsappFallbackUrl;
            }
          }, 1200);
        });
      } else {
        whatsappWidget.href = whatsappFallbackUrl;
        whatsappWidget.target = "_blank";
        whatsappWidget.rel = "noopener noreferrer";
      }
    }
  </script>

  </body>
</html>
