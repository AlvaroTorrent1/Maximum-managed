---
import "../styles/site.css";
import { content, locales, type Locale } from "../data";

type Props = { lang: Locale };

const { lang } = Astro.props;
const page = content[lang];
const currentLangLabel = lang.toUpperCase();

function localeHref(target: Locale) {
  if (lang === "nl") {
    return target === "nl" ? "./" : `./${target}/`;
  }

  return target === "nl" ? "../" : target === lang ? "./" : `../${target}/`;
}

const langLinks = locales.map((code) => ({
  code,
  href: localeHref(code),
}));

// YouTube video ID — client-selected Marbella background video
const HERO_VIDEO_ID = "3QUKrxHDFjo";

// Spot images — swap these three URLs with final client photography
// Recommended: Marbella Old Town, Puerto Banus marina, luxury villa with sea view
const spotImages = [
  "/plaza-de-los-naranjos.png", // Casco Antiguo Marbella
  "/istockphoto-1346794935-612x612.jpg", // Puerto Banus / Marina
  "https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&q=80&w=800", // Luxury Villa with sea view
];
---

<!doctype html>
<html lang={lang} translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/png" href="/maximum-managed-logo-symbol.png" />
    <link rel="apple-touch-icon" href="/maximum-managed-logo-symbol.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{page.metaTitle}</title>
  </head>

  <body id="top">

    <!-- ── HEADER ──────────────────────────────────────────────────────── -->
    <header class="site-header">
      <div class="header-inner">
        <a class="brand notranslate" href={localeHref(lang)}>
          <img
            class="brand-logo"
            src="/maximum-managed-header.svg"
            alt="Maximum Managed"
            width="2917"
            height="1336"
          />
        </a>

        <nav class="nav">
          <a href="#about">{page.nav.about}</a>
          <a href="#services">{page.nav.services}</a>
          <a href="#approach">{page.nav.approach}</a>
          <a href="#area">{page.nav.area}</a>
          <a href="#contact">{page.nav.contact}</a>
        </nav>

        <div class="langs notranslate">
          {langLinks.map((item) => (
            <a
              class="notranslate"
              href={item.href}
              aria-current={item.code === lang ? "page" : undefined}
              translate="no"
            >
              {item.code.toUpperCase()}
            </a>
          ))}
        </div>

        <details class="lang-menu notranslate">
          <summary aria-label="Select language" translate="no">
            <span class="lang-menu-current">{currentLangLabel}</span>
            <span class="lang-menu-caret" aria-hidden="true"></span>
          </summary>
          <div class="lang-menu-panel">
            {langLinks.map((item) => (
              <a
                class="notranslate"
                href={item.href}
                aria-current={item.code === lang ? "page" : undefined}
                translate="no"
              >
                {item.code.toUpperCase()}
              </a>
            ))}
          </div>
        </details>
      </div>
    </header>

    <main>

      <!-- ── HERO with YouTube video background ──────────────────────── -->
      <section class="hero">

        <!-- YouTube iframe cover -->
        <div class="hero-video-wrap" aria-hidden="true">
          <iframe
            src={`https://www.youtube.com/embed/${HERO_VIDEO_ID}?autoplay=1&mute=1&loop=1&playlist=${HERO_VIDEO_ID}&controls=0&disablekb=1&modestbranding=1&playsinline=1&rel=0&vq=hd1080&iv_load_policy=3&cc_load_policy=0&fs=0`}
            title="Maximum Managed — Marbella"
            allow="autoplay; encrypted-media"
            allowfullscreen={false}
          ></iframe>
        </div>

        <!-- Content -->
        <div class="hero-content">
          <div class="shell">
            <div class="hero-grid">

              <div class="hero-main">
                <p class="eyebrow">{page.hero.eyebrow}</p>
                <h1>{page.hero.title}</h1>
                <div class="hero-actions">
                  <a class="button primary" href="#contact">{page.hero.primary}</a>
                  <a class="button secondary" href="#services">{page.hero.secondary}</a>
                </div>
              </div>

              <!-- Desktop only — participates in parallax alongside hero text -->
              <aside class="hero-note hero-note-desktop">
                <h2>{page.hero.noteTitle}</h2>
                <p>{page.hero.noteText}</p>
              </aside>

            </div>
          </div>
        </div>
      </section>

      <!-- Mobile-only note card: lives outside the hero so it's never
           covered by the video and doesn't participate in the parallax -->
      <div class="hero-note-mobile-wrap">
        <div class="shell">
          <aside class="hero-note">
            <h2>{page.hero.noteTitle}</h2>
            <p>{page.hero.noteText}</p>
          </aside>
        </div>
      </div>

      <!-- ── INTRO (light) ────────────────────────────────────────────── -->
      <section class="section-intro-light">
        <div class="shell">
          <div class="intro-editorial">

            <!-- Left: big editorial statement -->
            <div class="intro-statement">
              <p class="intro-kicker">Property management</p>
              <h2 class="intro-headline">{page.intro.headline}</h2>
            </div>

            <!-- Right: three original paragraphs + trust bar -->
            <div class="intro-support">
              <p class="intro-p">
                {page.intro.paragraphs[0]}
              </p>
              <p class="intro-p">
                <em class="intro-accent">{page.intro.accent}</em>{page.intro.paragraphs[1]}
              </p>
              <p class="intro-p">
                {page.intro.paragraphs[2]}
              </p>

              <div class="intro-trust-bar">
                <div class="intro-trust-item">
                  <span class="intro-trust-num">100%</span>
                  <span class="intro-trust-label">{page.intro.trust[0]}</span>
                </div>
                <div class="intro-trust-divider"></div>
                <div class="intro-trust-item">
                  <span class="intro-trust-num">NL</span>
                  <span class="intro-trust-label">{page.intro.trust[1]}</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ── ABOUT (light, with photo) ───────────────────────────────── -->
      <section class="section-about" id="about">
        <div class="shell">
          <div class="about-grid">

            <div class="about-copy">
              <p class="eyebrow-dark">{page.about.kicker}</p>
              <h2>{page.about.title}</h2>
              <div class="copy">
                {page.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="chips">
                {page.about.chips.map((chip) => <span>{chip}</span>)}
              </div>
            </div>

            <!-- Photo — swap src for real team photo when available -->
            <div class="about-photo">
              <img 
                src="/Maximum_team.jpg" 
                alt="Maximum Managed team"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
              <div class="about-photo-caption">Marbella · Old Town</div>
            </div>

          </div>
        </div>
      </section>

      <!-- ── SERVICES (stacking cards on scroll) ─────────────────────── -->
      <section class="section-services" id="services">
        <div class="shell">
          <div class="services-header">
            <p class="eyebrow">{page.services.kicker}</p>
            <h2 class="section-title">{page.services.title}</h2>
            <div class="gold-rule"></div>
            <p class="section-lead">{page.services.intro}</p>
          </div>
        </div>

        <!-- Stack wrapper: pure CSS sticky accordion, no JS needed -->
        <div class="services-stack">
          {page.services.items.map((item, index) => (
            <div
              class="scard"
              style={`--i: ${index};`}
            >
              {/* Always-visible strip — peeks out when card is buried */}
              <div class="shell scard-strip">
                <span class="scard-num">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="scard-title">{item.title}</h3>
              </div>
              {/* Expandable body — only text, title lives in the strip above */}
              <div class="shell scard-body">
                <p class="scard-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── APPROACH (light) ─────────────────────────────────────────── -->
      <section class="section-approach" id="approach">
        <div class="shell">
          <div class="approach-grid">

            <div class="approach-header">
              <p class="eyebrow-dark">{page.approach.kicker}</p>
              <h2>{page.approach.title}</h2>
              <div class="gold-rule" style="margin: 16px 0;"></div>
              <p>{page.approach.intro}</p>
            </div>

            <div class="approach-points">
              {page.approach.points.map((point, i) => (
                <div class="approach-point">
                  <span class="approach-point-num">{String(i + 1).padStart(2, "0")}</span>
                  <p>{point}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      </section>

      <!-- ── REASONS (dark, clean list) ──────────────────────────────── -->
      <section class="section-reasons">
        <div class="shell">
          <div class="reasons-grid">

            <div>
              <p class="eyebrow">{page.reasons.kicker}</p>
              <h2 class="section-title">{page.reasons.title}</h2>
              <div class="gold-rule" style="margin-top: 16px;"></div>
            </div>

            <div class="reasons-list">
              {page.reasons.items.map((item) => (
                <div class="reason-item">
                  <span class="reason-dot"></span>
                  <p>{item}</p>
                </div>
              ))}
            </div>

          </div>
        </div>
      </section>

      <!-- ── AREA (light, with photo cards) ──────────────────────────── -->
      <section class="section-area" id="area">
        <div class="shell">
          <div class="area-header">
            <p class="eyebrow-dark">{page.area.kicker}</p>
            <h2 class="section-title dark">{page.area.title}</h2>
            <div class="gold-rule" style="margin: 16px 0;"></div>
            <p class="section-lead dark">{page.area.text}</p>
          </div>

          <div class="spot-grid">
            {page.area.spots.map((spot, i) => (
              <article class="spot-card">
                <img
                  class="spot-card-image"
                  src={spotImages[i]}
                  alt={spot.title}
                  loading="lazy"
                  decoding="async"
                />
                <div class="spot-card-body">
                  <h3>{spot.title}</h3>
                  {spot.text && <p>{spot.text}</p>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ── CONTACT (dark) ───────────────────────────────────────────── -->
      <section class="section-contact" id="contact">
        <div class="shell">
          <div class="contact-grid">

            <!-- Left: copy -->
            <div class="contact-header">
              <p class="eyebrow">{page.contact.kicker}</p>
              <h2>{page.contact.title}</h2>
              <div class="gold-rule" style="margin: 16px 0 20px;"></div>
              <p>{page.contact.text}</p>

              <!-- Email — bajo el copy en lugar de columna separada -->
              <div class="contact-reach">
                <p class="contact-reach-label">E-mail</p>
                <a class="contact-email notranslate" href="mailto:contact@maximum-managed.com">
                  contact@maximum-managed.com
                </a>
                <div class="contact-phones notranslate">
                  <p class="contact-reach-label">Telephone</p>
                  <p class="contact-person">Jim Smidt</p>
                  <a class="contact-phone" href="tel:+31626290290">+31 626 290 290</a>
                  <a class="contact-phone" href="tel:+34605019556">+34 605 019 556</a>
                  <p class="contact-person">Gijs Rijnierse</p>
                  <a class="contact-phone" href="tel:+31642207481">+31 642 2074 81</a>
                </div>
              </div>
            </div>

            <!-- Right: team photo — swap src when final photo is ready -->
            <div class="contact-photo-wrap">
              <img
                class="contact-photo"
                src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&q=80&w=900&h=700"
                alt="Maximum Managed team"
                loading="lazy"
                decoding="async"
              />
              <!-- Replace src above with final team photo — all sizing is handled by CSS -->
            </div>

          </div>
        </div>
      </section>

    </main>

    <!-- ── FOOTER ──────────────────────────────────────────────────────── -->
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-inner">
          <div class="footer-brand">
            <img
              class="footer-logo"
              src="/maximum-managed-logo-full.png"
              alt="Maximum Managed"
              width="420"
              height="252"
            />
            <p>{page.footer.tagline}</p>
          </div>
          <p class="footer-note">{page.footer.note}</p>
        </div>
      </div>
    </footer>

  <script>
    // Mide el header real y actualiza --header-h para que las sticky cards
    // nunca queden tapadas, independientemente del breakpoint o del wrapping de texto.
    const header = document.querySelector<HTMLElement>(".site-header");

    const syncHeaderHeight = () => {
      if (!header) return;
      const h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty("--header-h", `${Math.ceil(h)}px`);
    };

    syncHeaderHeight();
    window.addEventListener("resize", syncHeaderHeight, { passive: true });

    // Hero parallax: text moves up at ~40% of scroll speed, video stays fixed.
    // rAF + passive listener keeps it smooth and off the main thread.
    const heroContent = document.querySelector<HTMLElement>(".hero-content");
    const hero = document.querySelector<HTMLElement>(".hero");

    if (heroContent && hero) {
      let ticking = false;

      const update = () => {
        const scrollY = window.scrollY;
        const heroH = hero.offsetHeight;

        // Only apply while hero is still visible
        if (scrollY <= heroH) {
          // 0.4 = parallax speed factor (text moves at 40% of scroll speed)
          heroContent.style.transform = `translateY(${scrollY * 0.4}px)`;
        }
        ticking = false;
      };

      window.addEventListener("scroll", () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });
    }
  </script>

  </body>
</html>
